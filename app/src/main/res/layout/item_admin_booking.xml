<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:padding="12dp"
    android:elevation="3dp"
    android:layout_marginBottom="16dp">

    <ImageView
        android:id="@+id/imgAdminBookingCar"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="12dp"
        android:src="@drawable/prius_car" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_toEndOf="@id/imgAdminBookingCar">

        <TextView
            android:id="@+id/tvAdminVehicleName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehicle Name"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="16sp" />

        <!-- අලුතින් එකතු කළ Customer Name එක -->
        <TextView
            android:id="@+id/tvAdminCustomerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name: Customer Name"
            android:textColor="#333333"
            android:layout_marginTop="4dp"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAdminBookingDates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dates"
            android:textColor="#3F51B5"
            android:layout_marginTop="4dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvAdminCustomerPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone: 07XXXXXXXX"
            android:textColor="#D32F2F"
            android:layout_marginTop="4dp"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAdminBookingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booked At: "
            android:textColor="#757575"
            android:layout_marginTop="4dp"
            android:textSize="12sp" />

    </LinearLayout>
</RelativeLayout>